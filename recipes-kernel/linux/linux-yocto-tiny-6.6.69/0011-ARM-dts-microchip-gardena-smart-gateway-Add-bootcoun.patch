From de8a48beac6a1436f82622f4e4a91527a459614e Mon Sep 17 00:00:00 2001
From: Ezra Buehler <ezra.buehler@husqvarnagroup.com>
Date: Thu, 11 Jul 2024 20:26:16 +0200
Subject: [PATCH] ARM: dts: microchip: gardena-smart-gateway: Add bootcounter
 DT node

Signed-off-by: Ezra Buehler <ezra.buehler@husqvarnagroup.com>
Upstream-Status: Inappropriate [for U-Boot bootcounter driver]
---
 .../boot/dts/microchip/at91sam9g25-gardena-smart-gateway.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm/boot/dts/microchip/at91sam9g25-gardena-smart-gateway.dts b/arch/arm/boot/dts/microchip/at91sam9g25-gardena-smart-gateway.dts
index af70eb8a3a02..31bdbc49fbd6 100644
--- a/arch/arm/boot/dts/microchip/at91sam9g25-gardena-smart-gateway.dts
+++ b/arch/arm/boot/dts/microchip/at91sam9g25-gardena-smart-gateway.dts
@@ -105,6 +105,11 @@ pd21 {
 			status = "disabled";
 		};
 	};
+
+	bootcount@fffffe6c {
+		compatible = "uboot,bootcount";
+		reg = <0xfffffe6c 0x4>;
+	};
 };
 
 &macb0 {
-- 
2.43.0

