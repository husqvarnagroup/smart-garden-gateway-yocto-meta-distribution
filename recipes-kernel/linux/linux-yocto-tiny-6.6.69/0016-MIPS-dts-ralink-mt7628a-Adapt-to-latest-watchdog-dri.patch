From a7413ab4a73dbc7ce02d25b8a9f2d039985b0e5e Mon Sep 17 00:00:00 2001
From: Ezra Buehler <ezra.buehler@husqvarnagroup.com>
Date: Tue, 23 Jan 2024 14:38:39 +0200
Subject: [PATCH] MIPS: dts: ralink: mt7628a: Adapt to latest watchdog driver
 changes

Upstream-Status: Pending
---
 arch/mips/boot/dts/ralink/mt7628a.dtsi | 7 +------
 1 file changed, 1 insertion(+), 6 deletions(-)

diff --git a/arch/mips/boot/dts/ralink/mt7628a.dtsi b/arch/mips/boot/dts/ralink/mt7628a.dtsi
index 62fd31c6ee68..ee454fdd6c69 100644
--- a/arch/mips/boot/dts/ralink/mt7628a.dtsi
+++ b/arch/mips/boot/dts/ralink/mt7628a.dtsi
@@ -134,12 +134,7 @@ pinmux_p4led_an_gpio: p4led-an-gpio-pins {
 		watchdog: watchdog@100 {
 			compatible = "mediatek,mt7621-wdt";
 			reg = <0x100 0x30>;
-
-			resets = <&sysc 8>;
-			reset-names = "wdt";
-
-			interrupt-parent = <&intc>;
-			interrupts = <24>;
+			mediatek,sysctl = <&sysc>;
 
 			status = "disabled";
 		};
