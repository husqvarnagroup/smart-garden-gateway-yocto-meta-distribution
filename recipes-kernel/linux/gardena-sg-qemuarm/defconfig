# Architecture
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V5=y
CONFIG_ARCH_VERSATILE=y
CONFIG_AEABI=y
CONFIG_ARM_TIMER_SP804=y
CONFIG_USE_OF=y
CONFIG_ATAGS=y

# Hostname
CONFIG_DEFAULT_HOSTNAME="qemuarm"

# Console
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# PCI, needed for the virtio devices runqemu attaches
CONFIG_PCI=y
CONFIG_PCI_VERSATILE=y

# Root file system on a virtio disk
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_BLK_DEV=y

# Networking
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y

# Real time clock
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_PL031=y

# Entropy source, without it userspace stalls on /dev/random early in boot
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
