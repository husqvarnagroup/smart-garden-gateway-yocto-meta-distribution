From d28f0dbed217fa722f8c531d74154252a63c8c8c Mon Sep 17 00:00:00 2001
From: Reto Schneider <reto.schneider@husqvarnagroup.com>
Date: Sun, 23 Jan 2022 19:46:46 +0100
Subject: [PATCH] rtl8xxxu: Raise error level of IQK failures

Despite being recoverable, RX IQ calibration failure prints a warning.
Final IQ calibration errors should be noticed even more so.

Signed-off-by: Reto Schneider <reto.schneider@husqvarnagroup.com>
Upstream-Status: Pending
---
 drivers/net/wireless/realtek/rtl8xxxu/core.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/net/wireless/realtek/rtl8xxxu/core.c b/drivers/net/wireless/realtek/rtl8xxxu/core.c
index b0b83508b98d..2cda0a66e3ef 100644
--- a/drivers/net/wireless/realtek/rtl8xxxu/core.c
+++ b/drivers/net/wireless/realtek/rtl8xxxu/core.c
@@ -3376,7 +3376,7 @@ static void rtl8xxxu_phy_iqcalibrate(struct rtl8xxxu_priv *priv,
 			break;
 		} else if (i == (retry - 1) && path_a_ok == 0x01) {
 			/* TX IQK OK */
-			dev_dbg(dev, "%s: Path A IQK Only Tx Success!!\n",
+			dev_err(dev, "%s: Path A IQK only TX success!\n",
 				__func__);
 
 			val32 = rtl8xxxu_read32(priv,
@@ -3389,7 +3389,7 @@ static void rtl8xxxu_phy_iqcalibrate(struct rtl8xxxu_priv *priv,
 	}
 
 	if (!path_a_ok)
-		dev_dbg(dev, "%s: Path A IQK failed!\n", __func__);
+		dev_err(dev, "%s: Path A IQK failed!\n", __func__);
 
 	if (priv->tx_paths > 1) {
 		/*
@@ -3416,6 +3416,9 @@ static void rtl8xxxu_phy_iqcalibrate(struct rtl8xxxu_priv *priv,
 				break;
 			} else if (i == (retry - 1) && path_b_ok == 0x01) {
 				/* TX IQK OK */
+				dev_err(dev,
+					"%s: Path B IQK only TX success!\n",
+					__func__);
 				val32 = rtl8xxxu_read32(priv, REG_TX_POWER_BEFORE_IQK_B);
 				result[t][4] = (val32 >> 16) & 0x3ff;
 				val32 = rtl8xxxu_read32(priv, REG_TX_POWER_AFTER_IQK_B);
@@ -3424,7 +3427,7 @@ static void rtl8xxxu_phy_iqcalibrate(struct rtl8xxxu_priv *priv,
 		}
 
 		if (!path_b_ok)
-			dev_dbg(dev, "%s: Path B IQK failed!\n", __func__);
+			dev_err(dev, "%s: Path B IQK failed!\n", __func__);
 	}
 
 	/* Back to BB mode, load original value */
-- 
