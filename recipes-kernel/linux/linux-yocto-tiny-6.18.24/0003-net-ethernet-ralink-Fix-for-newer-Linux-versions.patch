From c8edb6882eaa694fc3cebb508b20487b022823a8 Mon Sep 17 00:00:00 2001
From: Ezra Buehler <ezra@easyb.ch>
Date: Mon, 15 Jan 2024 22:44:26 +0200
Subject: [PATCH] net: ethernet: ralink: Fix for newer Linux versions

Signed-off-by: Ezra Buehler <ezra.buehler@husqvarnagroup.com>
Upstream-Status: Pending [to OpenWrt]
---
 drivers/net/ethernet/ralink/esw_rt3050.c  | 2 +-
 drivers/net/ethernet/ralink/ethtool.c     | 3 ++-
 drivers/net/ethernet/ralink/mtk_eth_soc.c | 9 ++++++---
 3 files changed, 9 insertions(+), 5 deletions(-)

diff --git a/drivers/net/ethernet/ralink/esw_rt3050.c b/drivers/net/ethernet/ralink/esw_rt3050.c
index 9cd6fc456c0a..0d77db511bf9 100644
--- a/drivers/net/ethernet/ralink/esw_rt3050.c
+++ b/drivers/net/ethernet/ralink/esw_rt3050.c
@@ -1521,7 +1521,7 @@ int rt3050_esw_init(struct fe_priv *priv)
 
 static struct platform_driver esw_driver = {
 	.probe = esw_probe,
-	.remove_new = esw_remove,
+	.remove = esw_remove,
 	.driver = {
 		.name = "rt3050-esw",
 		.of_match_table = ralink_esw_match,
diff --git a/drivers/net/ethernet/ralink/ethtool.c b/drivers/net/ethernet/ralink/ethtool.c
index 63d904e4bff4..72a2692ac4b9 100644
--- a/drivers/net/ethernet/ralink/ethtool.c
+++ b/drivers/net/ethernet/ralink/ethtool.c
@@ -12,6 +12,7 @@
  *   Copyright (C) 2013-2015 Michael Lee <igvtee@gmail.com>
  */
 
+#include "ethtool.h"
 #include "mtk_eth_soc.h"
 #include "ethtool.h"
 
@@ -166,7 +167,7 @@ static void fe_get_strings(struct net_device *dev, u32 stringset, u8 *data)
 {
 	switch (stringset) {
 	case ETH_SS_STATS:
-		ethtool_puts(&data, *fe_gdma_str);
+		memcpy(data, *fe_gdma_str, sizeof(fe_gdma_str));
 		break;
 	}
 }
diff --git a/drivers/net/ethernet/ralink/mtk_eth_soc.c b/drivers/net/ethernet/ralink/mtk_eth_soc.c
index 5a8e92ab1216..9f3da70650c6 100644
--- a/drivers/net/ethernet/ralink/mtk_eth_soc.c
+++ b/drivers/net/ethernet/ralink/mtk_eth_soc.c
@@ -244,10 +244,10 @@ static void fe_clean_rx(struct fe_priv *priv)
 		ring->rx_dma = NULL;
 	}
 
-	if (!ring->frag_cache.va)
+	if (!ring->frag_cache.encoded_page)
 	    return;
 
-	page = virt_to_page(ring->frag_cache.va);
+	page = virt_to_page(ring->frag_cache.encoded_page);
 	__page_frag_cache_drain(page, ring->frag_cache.pagecnt_bias);
 	memset(&ring->frag_cache, 0, sizeof(ring->frag_cache));
 }
@@ -1615,6 +1615,9 @@ static int fe_probe(struct platform_device *pdev)
 	priv->rx_ring.rx_ring_size = NUM_DMA_DESC;
 	INIT_WORK(&priv->pending_work, fe_pending_work);
 
+	if (priv->hw_stats)
+		u64_stats_init(&priv->hw_stats->syncp);
+
 	napi_weight = 16;
 	if (priv->flags & FE_FLAG_NAPI_WEIGHT) {
 		napi_weight *= 4;
@@ -1652,7 +1655,7 @@ static void fe_remove(struct platform_device *pdev)
 
 static struct platform_driver fe_driver = {
 	.probe = fe_probe,
-	.remove_new = fe_remove,
+	.remove = fe_remove,
 	.driver = {
 		.name = "mtk_soc_eth",
 		.of_match_table = of_fe_match,
-- 
2.43.0

